import Base
import ../libs/JSON.bend as J
import ./JSON_PrimitiveProof.bend as P

def append_nil(+text: String) -> {text ++ SNil{} == text : String}:
    match text:
        case SNil{}: {==}
        case SCon{h, t}:
            Equal.cong(String, String, s => SCon{h, s}, t ++ SNil{}, t, append_nil(t))

def append_assoc(+a: String, +b: String, +c: String) -> {(a ++ b) ++ c == a ++ (b ++ c) : String}:
    match a:
        case SNil{}: {==}
        case SCon{h, t}:
            Equal.cong(String, String, s => SCon{h, s}, (t ++ b) ++ c, t ++ (b ++ c), append_assoc(t, b, c))

def reverse_go_append(+text: String,
                      +acc: String,
                      +suffix: String) -> {String.reverse.go(text, acc ++ suffix) == String.reverse.go(text, acc) ++ suffix : String}:
    match text:
        case SNil{}: {==}
        case SCon{head, tail}:
            Equal.trans(String,
                String.reverse.go(tail, SCon{head, acc ++ suffix}),
                String.reverse.go(tail, SCon{head, acc} ++ suffix),
                String.reverse.go(tail, SCon{head, acc}) ++ suffix,
                {==},
                reverse_go_append(tail, SCon{head, acc}, suffix))

def reverse_cons(+head: Char,
                 +tail: String) -> {String.reverse(SCon{head, tail}) == String.reverse(tail) ++ SCon{head, SNil{}} : String}:
    reverse_go_append(tail, SNil{}, SCon{head, SNil{}})

def reverse_append(+left: String,
                   +right: String) -> {String.reverse(left ++ right) == String.reverse(right) ++ String.reverse(left) : String}:
    match left:
        case SNil{}:
            Equal.sym(String, String.reverse(right) ++ SNil{}, String.reverse(right), append_nil(String.reverse(right)))
        case SCon{head, tail}:
            Equal.trans(String, String.reverse(SCon{head, tail} ++ right),
                String.reverse(tail ++ right) ++ SCon{head, SNil{}},
                String.reverse(right) ++ String.reverse(SCon{head, tail}),
                reverse_cons(head, tail ++ right),
                Equal.trans(String, String.reverse(tail ++ right) ++ SCon{head, SNil{}},
                    (String.reverse(right) ++ String.reverse(tail)) ++ SCon{head, SNil{}},
                    String.reverse(right) ++ String.reverse(SCon{head, tail}),
                    Equal.cong(String, String, value => value ++ SCon{head, SNil{}}, String.reverse(tail ++ right),
                        String.reverse(right) ++ String.reverse(tail), reverse_append(tail, right)),
                    Equal.trans(String, (String.reverse(right) ++ String.reverse(tail)) ++ SCon{head, SNil{}},
                    String.reverse(right) ++ (String.reverse(tail) ++ SCon{head, SNil{}}),
                    String.reverse(right) ++ String.reverse(SCon{head, tail}),
                    append_assoc(String.reverse(right), String.reverse(tail), SCon{head, SNil{}}),
                    Equal.cong(String, String, value => String.reverse(right) ++ value,
                        String.reverse(tail) ++ SCon{head, SNil{}}, String.reverse(SCon{head, tail}),
                        Equal.sym(String, String.reverse(SCon{head, tail}), String.reverse(tail) ++ SCon{head, SNil{}}, reverse_cons(head, tail))))))

def reverse_twice(+text: String) -> {String.reverse(String.reverse(text)) == text : String}:
    match text:
        case SNil{}: {==}
        case SCon{head, tail}:
            Equal.trans(String, String.reverse(String.reverse(SCon{head, tail})),
                String.reverse(String.reverse(tail) ++ SCon{head, SNil{}}), SCon{head, tail},
                Equal.cong(String, String, String.reverse, String.reverse(SCon{head, tail}), String.reverse(tail) ++ SCon{head, SNil{}}, reverse_cons(head, tail)),
                Equal.trans(String, String.reverse(String.reverse(tail) ++ SCon{head, SNil{}}),
                    String.reverse(SCon{head, SNil{}}) ++ String.reverse(String.reverse(tail)), SCon{head, tail},
                    reverse_append(String.reverse(tail), SCon{head, SNil{}}),
                    Equal.cong(String, String, value => SCon{head, value}, String.reverse(String.reverse(tail)), tail, reverse_twice(tail))))

