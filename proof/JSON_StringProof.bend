def escaped_body(+text: String) -> {J.fast_string(J.escape_string(text) ++ "\"") == J.Decoded{text} : J.FastString}:
    match text:
        case SNil{}: {==}
        case SCon{h, t}:
            Equal.trans(J.FastString, J.fast_string((J.escape_char(h) ++ J.escape_string(t)) ++ "\""), J.fast_string(J.escape_char(h) ++ (J.escape_string(t) ++ "\"")), J.Decoded{SCon{h, t}},
                Equal.cong(String, J.FastString, J.fast_string, (J.escape_char(h) ++ J.escape_string(t)) ++ "\"", J.escape_char(h) ++ (J.escape_string(t) ++ "\""), append_assoc(J.escape_char(h), J.escape_string(t), "\"")),
                escape_one(h, J.escape_string(t) ++ "\"", t, escaped_body(t)))

def number_quote(+text: String) -> {J.number_valid(SCon{'"', text}) == False{} : Bool}:
    Equal.cong(J.NumberState, Bool, J.number_valid_end, J.number_valid_step(text, J.NumberInvalid{}), J.NumberInvalid{}, P.invalid_step(text))

def string_payload(+text: String) -> {J.decode_payload("\"" ++ J.escape_string(text) ++ "\"") == Done{J.Str{text}} : Result<&1, &1, J.Error, J.Value>}:
    Equal.trans(P.R(), J.decode_payload("\"" ++ J.escape_string(text) ++ "\""), J.payload_other("\"" ++ J.escape_string(text) ++ "\""), Done{J.Str{text}},
        P.decode_false("\"" ++ J.escape_string(text) ++ "\"", number_quote(J.escape_string(text) ++ "\"")),
        Equal.cong(J.FastString, P.R(), r => J.fast_result(r, "\"" ++ J.escape_string(text) ++ "\""),
            J.fast_string(J.escape_string(text) ++ "\""), J.Decoded{text}, escaped_body(text)))
